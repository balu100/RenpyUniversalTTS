{
  "enabled": true,
  "engine": "chatterbox",
  "speaker_name_mode": "on_speaker_change",
  "request": {
    "type": "chatterbox_tts"
  },
  "chatterbox": {
    "url": "http://localhost:8880/tts",
    "output_format": "pcm",
    "stream": true,
    "chunk_size": 50,
    "split_text": true,
    "default_profile": {
      "voice_mode": "predefined",
      "predefined_voice_id": "Emily.wav",
      "temperature": 0.8,
      "exaggeration": 1.0,
      "cfg_weight": 0.5,
      "speed_factor": 1.0
    },
    "profiles": {
      "Narrator": {
        "voice_mode": "predefined",
        "predefined_voice_id": "Emily.wav"
      },
      "Alice": {
        "voice_mode": "predefined",
        "predefined_voice_id": "Alice.wav"
      },
      "Bob": {
        "voice_mode": "predefined",
        "predefined_voice_id": "Michael.wav"
      }
    }
  }
}
